[Unit]
Description=Levik DNSTT authenticated TCP egress
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=levik-tuic
Group=levik-tuic
ExecStart=/usr/bin/python3 /opt/levik-dnstt/releases/20261028-pilot1/proxy.py
Restart=on-failure
RestartSec=10
MemoryMax=96M
CPUQuota=30%
TasksMax=32
LimitNOFILE=512
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
BindReadOnlyPaths=/etc/levik-dnstt/resolv.conf:/etc/resolv.conf
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
