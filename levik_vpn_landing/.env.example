# Server Database Configuration
POSTGRES_DB=leviknet
POSTGRES_USER=levik_owner
POSTGRES_PASSWORD=replace-with-strong-db-owner-password
APP_DATABASE_ROLE=levik_app
APP_DATABASE_PASSWORD=replace-with-strong-app-password
DB_HOST=db
DB_PORT=5432

# Production URLs & Domains
BASE_URL=https://leviknet.com
APP_URL=https://leviknet.com
SITE_URL=https://leviknet.com
NODE_ENV=production

# Remnawave Integration
REMNAWAVE_BASE_URL=https://remnawave-caddy:3443
REMNAWAVE_STATUS_URL=https://remnawave-status.example.com
REMNAWAVE_API_TOKEN=replace-with-remnawave-api-token
REMNAWAVE_TLS_VERIFY=false

# Cryptographic Keys (Base64URL 32-byte keys)
SESSION_ENCRYPTION_KEY=replace-with-base64url-32-byte-secret
CSRF_HMAC_KEY=replace-with-base64url-32-byte-secret
AUDIT_HMAC_KEY=replace-with-base64url-32-byte-secret
MAINTENANCE_TOKEN=replace-with-base64url-32-byte-secret

# Authentication Providers
# Google Sign-In
GOOGLE_WEB_CLIENT_ID=example-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_IDS=example-android-client-id.apps.googleusercontent.com

# Play Integrity (Optional for Direct, Required for Play release)
MOBILE_PLAY_INTEGRITY_REQUIRED=false
MOBILE_PLAY_INTEGRITY_SERVICE_ACCOUNT_EMAIL=
MOBILE_PLAY_INTEGRITY_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=

# Mobile Configuration & App Links
MOBILE_ANDROID_PACKAGE_NAME=com.leviknet.vpn
MOBILE_ANDROID_CERTIFICATE_SHA256_DIGESTS=wfDNgjm9uNLjgCwU1Mu9epzHSnTbeK8EaYX7F1btBhI

# Allowed Origins
PAYMENT_URL_ALLOWED_ORIGINS=https://app.platega.io,https://pay.platega.io
SUBSCRIPTION_URL_ALLOWED_ORIGINS=https://sub.leviknet.com:2095,https://sub.leviknet.com:2096

# Admin & Features
ADMIN_USER_KEYS=
FEATURE_ADMIN_UPDATES_ENABLED=false
FEATURE_FREE_PROXY_ENABLED=false
SITE_FREE_PROXY_TOKEN=
