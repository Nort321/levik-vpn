#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
umask 022

readonly release_root="/srv/levik-android-releases/stable"
readonly incoming_root="/srv/levik-android-releases/incoming"
readonly public_key="/etc/leviknet/direct-update-public.pem"
readonly max_archive_bytes=$((1024 * 1024 * 1024))

IFS= read -r release_tag
if [[ ! "${release_tag}" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  printf 'ERROR: invalid Android release tag.\n' >&2
  exit 64
fi
readonly version_name="${BASH_REMATCH[1]}"
readonly release_directory="${release_root}/${release_tag}"

if [[ ! -f "${public_key}" || -L "${public_key}" ]]; then
  printf 'ERROR: Direct update public key is unavailable.\n' >&2
  exit 1
fi
if [[ -e "${release_directory}" || -L "${release_directory}" ]]; then
  printf 'ERROR: refusing to replace immutable Android release %s.\n' "${release_tag}" >&2
  exit 1
fi

mkdir -p -- "${release_root}" "${incoming_root}"
readonly temporary_directory="$(mktemp -d "${incoming_root}/${release_tag}.XXXXXX")"
readonly archive="${temporary_directory}.tar.gz"
cleanup() {
  rm -rf -- "${temporary_directory}" "${archive}" "${temporary_directory}.listing"
}
trap cleanup EXIT

cat >"${archive}"
readonly archive_size="$(wc -c <"${archive}" | tr -d '[:space:]')"
if [[ ! "${archive_size}" =~ ^[0-9]+$ || "${archive_size}" -lt 1048576 ||
      "${archive_size}" -gt "${max_archive_bytes}" ]]; then
  printf 'ERROR: Android release archive is outside the allowed size.\n' >&2
  exit 1
fi

readonly archive_listing="${temporary_directory}.listing"
tar -tzf "${archive}" >"${archive_listing}"
if [[ ! -s "${archive_listing}" ]] ||
   grep -Ev '^[A-Za-z0-9][A-Za-z0-9._+-]*$' "${archive_listing}" >/dev/null ||
   sort "${archive_listing}" | uniq -d | grep -q .; then
  printf 'ERROR: Android release archive contains unsafe or duplicate paths.\n' >&2
  exit 1
fi

tar -xzf "${archive}" \
  --directory "${temporary_directory}" \
  --no-same-owner \
  --no-same-permissions
if find "${temporary_directory}" -mindepth 1 ! -type f -print -quit | grep -q .; then
  printf 'ERROR: Android release archive contains a non-regular file.\n' >&2
  exit 1
fi

readonly apk_name="LevikVPN-direct-${version_name}.apk"
required_files=(
  "${apk_name}"
  update.json
  update.json.sig
  latest.json
  SHA256SUMS
  PUBLIC-SHA256SUMS
  THIRD_PARTY_NOTICES-root.md
  THIRD_PARTY_NOTICES-android.md
  levik-vpn-android.cdx.json
  levik-vpn-native.cdx.json
  "LevikVPN-corresponding-source-${version_name}.tar.gz"
)
for required_file in "${required_files[@]}"; do
  if [[ ! -f "${temporary_directory}/${required_file}" ]]; then
    printf 'ERROR: required Android release asset is missing: %s\n' "${required_file}" >&2
    exit 1
  fi
done

(
  cd "${temporary_directory}"
  sha256sum --check --strict PUBLIC-SHA256SUMS
  sha256sum --check --strict SHA256SUMS
)

readonly binary_signature="${temporary_directory}/update.json.sig.der"
base64 --decode "${temporary_directory}/update.json.sig" >"${binary_signature}"
openssl dgst -sha256 \
  -verify "${public_key}" \
  -signature "${binary_signature}" \
  "${temporary_directory}/update.json" >/dev/null
rm -f -- "${binary_signature}"

python3 - "${temporary_directory}" "${release_tag}" "${version_name}" "${apk_name}" <<'PY'
import json
import pathlib
import sys

directory = pathlib.Path(sys.argv[1])
tag, version, apk_name = sys.argv[2:]
base = f"https://leviknet.com/downloads/android/stable/{tag}"
feed = json.loads((directory / "latest.json").read_text(encoding="utf-8"))
if (
    feed.get("schemaVersion") != 1
    or feed.get("channel") != "stable"
    or feed.get("tag_name") != tag
    or feed.get("draft") is not False
    or feed.get("prerelease") is not False
):
    raise SystemExit("invalid Direct release feed metadata")
assets = feed.get("assets")
expected_names = {"update.json", "update.json.sig", apk_name}
if not isinstance(assets, list) or {item.get("name") for item in assets} != expected_names:
    raise SystemExit("invalid Direct release feed assets")
for item in assets:
    name = item["name"]
    path = directory / name
    if item.get("size") != path.stat().st_size or item.get("url") != f"{base}/{name}":
        raise SystemExit("Direct release feed does not match published assets")

manifest = json.loads((directory / "update.json").read_text(encoding="utf-8"))
if (
    manifest.get("versionName") != version
    or manifest.get("apkUrl") != f"{base}/{apk_name}"
    or manifest.get("apkSize") != (directory / apk_name).stat().st_size
):
    raise SystemExit("signed update manifest does not match the release")
PY

find "${temporary_directory}" -type f -exec chmod 0444 {} +
chmod 0555 "${temporary_directory}"
mv -- "${temporary_directory}" "${release_directory}"
readonly latest_temporary="${release_root}/.latest-${release_tag}.json"
cp -- "${release_directory}/latest.json" "${latest_temporary}"
chmod 0444 "${latest_temporary}"
mv -- "${latest_temporary}" "${release_root}/latest.json"
trap - EXIT
rm -f -- "${archive}" "${archive_listing}"
printf 'Published immutable Android Direct release %s.\n' "${release_tag}"
