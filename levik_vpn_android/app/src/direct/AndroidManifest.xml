<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Lint inspects this flavor manifest before merging the main VPN declaration. -->
        <service
            android:name=".vpn.LevikVpnService"
            android:foregroundServiceType="specialUse" />
        <service
            android:name=".vpn.YandexGuestRefreshService"
            android:process=":yandex_guest"
            android:exported="false" />
        <activity
            android:name=".vpn.YandexGuestActivity"
            android:process=":yandex_guest"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LevikVpn" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- "Share" a link to Levik VPN: through the VPN or directly, docs/app-platform.md "Account rules". -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".vpn.RelayVkAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LevikVpn" />
    </application>
</manifest>
